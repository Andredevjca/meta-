@model PerfilViewModel
@{ViewData["Title"]="Meu perfil";}
<div class="titulo-pagina"><div><h1>Meu perfil</h1><p>Seu espaço, do seu jeito.</p></div></div><form method="post" action="/Perfil" class="painel form-limitado">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation"></div><label asp-for="Nome">Nome</label><input asp-for="Nome" /><label>E-mail</label><input value="@Model.Email" readonly aria-label="E-mail" /><label asp-for="Telefone">Telefone</label><input asp-for="Telefone" autocomplete="tel" /><label asp-for="DataNascimento">Data de nascimento (opcional)</label><input asp-for="DataNascimento" type="date" /><h2 class="mt-4">Alterar senha</h2><p class="muted">Preencha somente se quiser trocar a senha.</p><label for="senhaAtual">Senha atual</label><input id="senhaAtual" name="senhaAtual" type="password" autocomplete="current-password" /><label for="novaSenha">Nova senha</label><input id="novaSenha" name="novaSenha" type="password" autocomplete="new-password" minlength="8" maxlength="72" /><label for="confirmacaoSenha">Confirme a nova senha</label><input id="confirmacaoSenha" name="confirmacaoSenha" type="password" autocomplete="new-password" /><div class="form-acoes"><button class="btn btn-primary">Salvar perfil</button></div></form>
