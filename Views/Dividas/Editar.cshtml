@model Divida
@{ViewData["Title"]="Organizar dívida";}
<a class="voltar" href="/Dividas">← Minhas dívidas</a><div class="titulo-pagina"><div><h1>Organizar dívida</h1><p>Mais clareza sobre cada compromisso.</p></div></div><form method="post" action="/Dividas/Salvar" class="painel form-limitado">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation"></div><input asp-for="Id" type="hidden" /><label asp-for="Descricao">Descrição</label><input asp-for="Descricao" /><label asp-for="Credor">Credor</label><input asp-for="Credor" /><div class="campo-grid"><div><label asp-for="ValorTotal">Valor total (R$)</label><input asp-for="ValorTotal" type="text" data-moeda inputmode="decimal" /></div><div><label asp-for="ValorParcela">Valor da parcela (R$)</label><input asp-for="ValorParcela" type="text" data-moeda inputmode="decimal" /></div><div><label asp-for="QuantidadeParcelas">Quantidade de parcelas</label><input asp-for="QuantidadeParcelas" /></div><div><label asp-for="ParcelasPagas">Parcelas pagas</label><input asp-for="ParcelasPagas" /></div></div><label asp-for="DataInicio">Vencimento da primeira parcela</label><input asp-for="DataInicio" type="date" /><div class="form-acoes"><a href="/Dividas" class="btn btn-light">Cancelar</a><button class="btn btn-primary">Salvar dívida</button></div></form>
