@model List<Divida>
@{ViewData["Title"]="Dívidas";}
@if (TempData["AvisoDivida"] is string aviso) { <div class="alert alert-warning" role="status">@aviso</div> }
<div class="titulo-pagina"><div><span class="eyebrow">UM CAMINHO PARA MAIS TRANQUILIDADE</span><h1>Minhas dívidas</h1><p>Acompanhe suas parcelas e o que falta para quitar.</p></div><a class="btn btn-primary" href="/Dividas/Editar">+ Nova dívida</a></div><div class="objetivos-grid">@foreach(var d in Model){<article class="painel"><div class="entre"><span class="objetivo-icone"><i class="fa-regular fa-credit-card"></i></span><span class="badge-suave">@d.Status</span></div><h2 class="mt-3">@d.Descricao</h2><p class="muted">@d.Credor</p><div class="objetivo-valores"><strong>@d.ValorRestante.ToString("C")</strong><span>restantes</span></div><div class="progress"><div style="width:@((100m*d.ParcelasPagas/d.QuantidadeParcelas).ToString("0.##",CultureInfo.InvariantCulture))%"></div></div><p>@d.ParcelasPagas de @d.QuantidadeParcelas parcelas pagas</p><p class="muted">Parcela: @d.ValorParcela.ToString("C")<br />@d.DataInicio.ToString("dd/MM/yyyy") a @d.DataFinal.ToString("dd/MM/yyyy")</p>@if (d.ProximoVencimento is DateTime vencimento)
{
    <p>Próxima parcela: @(d.ParcelasPagas + 1) de @d.QuantidadeParcelas<br />Vencimento: @vencimento.ToString("dd/MM/yyyy")</p>
}
<div class="d-flex flex-wrap gap-2 align-items-center">
    <a class="btn btn-outline-primary" href="/Dividas/Editar/@d.Id">Atualizar parcelas</a>
    @if (d.ProximoVencimento.HasValue)
    {
        <form method="post" action="/Dividas/Pagar/@d.Id">
            @Html.AntiForgeryToken()
            <input type="hidden" name="parcelasPagas" value="@d.ParcelasPagas" />
            <button type="submit" class="btn btn-primary" aria-label="Pagar parcela @(d.ParcelasPagas + 1) de @d.Descricao">Pagar</button>
        </form>
    }
</div><form class="mt-2" method="post" action="/Dividas/Excluir/@d.Id" data-confirm="Excluir esta dívida?">@Html.AntiForgeryToken()<button class="btn btn-link text-danger">Excluir</button></form></article>}</div>@if(!Model.Any()){<div class="estado-vazio"><i class="fa-solid fa-leaf vazio-icone"></i><h3>Nenhuma dívida cadastrada.</h3><p>Se houver parcelas em aberto, adicione para refinar sua capacidade financeira.</p></div>}
