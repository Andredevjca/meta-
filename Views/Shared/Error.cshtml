@model ErrorViewModel
@{ViewData["Title"]="Não foi possível concluir";}
<section class="estado-vazio"><i class="fa-solid fa-circle-exclamation vazio-icone"></i><h1>Não foi possível concluir esta ação.</h1><p>Tente novamente. Se o problema continuar, verifique a conexão com o banco de dados.</p><a class="btn btn-primary" href="/Dashboard">Voltar ao início</a>@if(Model.ShowRequestId){<p class="muted mt-3">Referência: @Model.RequestId</p>}</section>
