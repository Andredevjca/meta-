<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · Meta+</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" /><link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body>
<aside class="sidebar" id="sidebar"><partial name="_Navegacao" /></aside><button class="menu-overlay" aria-label="Fechar menu" tabindex="-1"></button>
<div class="app-main"><header class="topbar"><div><button class="icon-button menu-toggle" aria-label="Alternar menu" aria-expanded="false"><i class="fa-solid fa-bars"></i></button><span class="breadcrumb-text">Meu planejamento <span>/</span> <strong>@ViewData["Title"]</strong></span></div><div class="topbar-direita"><span class="data-hoje">@DateTime.Today.ToString("dd 'de' MMMM, yyyy")</span><a href="/Notificacoes" class="icon-button" aria-label="Notificações"><i class="fa-regular fa-bell"></i></a><a class="avatar" href="/Perfil">@(User.Identity?.Name?.Substring(0,1)??"A")</a></div></header>
<main class="conteudo" id="app-page" tabindex="-1">@if(TempData["Sucesso"] is string sucesso){<div class="toast-meta" role="status"><i class="fa-solid fa-circle-check"></i> @sucesso<button class="fechar-toast icon-button" aria-label="Fechar">×</button></div>}@if(TempData["Aviso"] is string aviso){<div class="alert alert-warning">@aviso <a href="/Perfil">Alterar senha</a></div>}@RenderBody()</main><footer class="rodape"><span>meta+ <span class="muted">· Seus objetivos. Seu plano. Sua conquista.</span></span><small>Um passo de cada vez.</small></footer></div><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
