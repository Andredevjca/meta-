@model CadastroViewModel
@{Layout="_LayoutConta";ViewData["Title"]="Criar conta";}
<span class="eyebrow">TRANSFORME PLANOS EM CONQUISTAS</span><h1>Comece a sua história.</h1><p class="muted">Organize o presente. Planeje o que vem pela frente.</p>
<form method="post" action="/Cadastro">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation"></div><label asp-for="Nome">Seu nome</label><input asp-for="Nome" autocomplete="name" /><label asp-for="Email">E-mail</label><input asp-for="Email" autocomplete="username" /><label asp-for="Senha">Senha</label><input asp-for="Senha" minlength="8" maxlength="72" autocomplete="new-password" /><label asp-for="ConfirmacaoSenha">Confirme a senha</label><input asp-for="ConfirmacaoSenha" type="password" autocomplete="new-password" /><button class="btn btn-primary w-100 mt-4">Criar minha conta <i class="fa-solid fa-arrow-right"></i></button></form><p class="conta-alternativa">Já tem uma conta? <a href="/Login">Entrar</a></p>
