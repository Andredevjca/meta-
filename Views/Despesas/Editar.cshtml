@model Lancamento
@{string tipo=ViewBag.Tipo;ViewData["Title"]=(Model.Id==0?"Adicionar":"Editar")+" · "+tipo;}
<a class="voltar" href="/@tipo">← @tipo</a><div class="titulo-pagina"><div><h1>@ViewData["Title"]</h1><p>Uma visão completa começa nos detalhes.</p></div></div><form method="post" action="/@tipo/Salvar" class="painel form-limitado">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation"></div><input asp-for="Id" type="hidden" /><label asp-for="Descricao">Descrição</label><input asp-for="Descricao" placeholder="@(tipo=="Receitas"?"Ex.: Salário":"Ex.: Aluguel")" /><label asp-for="Categoria">@(tipo=="Receitas"?"Tipo":"Categoria")</label><select asp-for="Categoria">@foreach(var c in tipo=="Receitas"?new[]{"Salário","Renda extra","Benefício","Comissão","Outros"}:new[]{"Moradia","Alimentação","Transporte","Educação","Saúde","Lazer","Assinaturas","Contas","Outros"}){<option>@c</option>}</select><div class="campo-grid"><div><label asp-for="Valor">Valor (R$)</label><input asp-for="Valor" type="text" inputmode="decimal" data-moeda /></div><div><label asp-for="Periodicidade">Periodicidade</label><select asp-for="Periodicidade"><option>Mensal</option><option>Semanal</option><option>Quinzenal</option><option>Eventual</option></select></div></div><label asp-for="Data">@(tipo=="Receitas"?"Data de recebimento / início":"Vencimento / início")</label><input asp-for="Data" type="date" /><label class="check mt-3"><input asp-for="Ativo" /> Lançamento ativo</label>@if(tipo=="Despesas"){<label class="check"><input asp-for="Fixa" /> Despesa fixa (desmarque para variável)</label>}<div class="form-acoes"><a href="/@tipo" class="btn btn-light">Cancelar</a><button class="btn btn-primary">Salvar lançamento</button></div></form>
