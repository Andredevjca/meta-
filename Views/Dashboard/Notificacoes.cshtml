@model List<string>
@{ViewData["Title"]="Notificações";var painel=(PainelViewModel)ViewBag.Painel;}
<div class="titulo-pagina"><div><h1>Seu plano está com você.</h1><p>Lembretes para manter suas conquistas por perto.</p></div><form method="post" action="/Notificacoes/Ler">@Html.AntiForgeryToken()<button class="btn btn-light">Marcar mensagens como lidas</button></form></div><section class="painel">@foreach(var p in painel.Objetivos.Where(x=>x.Objetivo.Status=="Ativo")){if(p.Calculo.ProximoCheckin?.Date==DateTime.Today){<a class="linha-lista" href="/Objetivos/Contribuicao/@p.Objetivo.Id">🎯 Hoje é dia de atualizar sua contribuição: @p.Objetivo.Nome.</a>}if(p.Objetivo.DataLimite<=DateTime.Today.AddDays(5)){<a class="linha-lista" href="/Objetivos/Detalhes/@p.Objetivo.Id">O prazo de @p.Objetivo.Nome é @p.Objetivo.DataLimite.ToString("dd/MM/yyyy"). Veja seu planejamento.</a>}if(p.Calculo.Percentual>=90){<a class="linha-lista" href="/Objetivos/Detalhes/@p.Objetivo.Id">✦ @p.Objetivo.Nome está quase lá! Faltam @p.Calculo.Restante.ToString("C").</a>}}@foreach(var n in Model){<div class="linha-lista"><span class="icone-circulo"><i class="fa-solid fa-check"></i></span><p class="mb-0">@n</p></div>}@if(!Model.Any()){<p class="vazio-pequeno">Nenhuma nova mensagem de contribuição.</p>}</section>
