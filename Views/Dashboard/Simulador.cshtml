@{ViewData["Title"]="Simulador";}
<div class="titulo-pagina"><div><span class="eyebrow">EXPLORE POSSIBILIDADES</span><h1>E se você começasse hoje?</h1><p>Descubra o caminho para seu próximo objetivo.</p></div></div><div class="duas-colunas"><form id="form-objetivo" class="painel">@Html.AntiForgeryToken()<input type="hidden" name="Nome" value="Simulação" /><input type="hidden" name="DataInicio" value="@DateTime.Today.ToString("yyyy-MM-dd")" /><input type="hidden" name="Frequencia" value="Mensal" /><h2>Quanto preciso guardar?</h2><label for="ValorObjetivo">Valor desejado (R$)</label><input id="ValorObjetivo" name="ValorObjetivo" data-moeda inputmode="decimal" value="5.000,00" /><label for="ValorInicial">Já tenho (R$)</label><input id="ValorInicial" name="ValorInicial" data-moeda inputmode="decimal" value="0,00" /><label for="DataLimite">Quero alcançar até</label><input id="DataLimite" name="DataLimite" type="date" value="@DateTime.Today.AddYears(1).ToString("yyyy-MM-dd")" /><button type="button" class="btn btn-primary mt-4" id="simular">Calcular meu plano</button><div id="resultado-simulacao" aria-live="polite"></div></form><form method="post" action="/Simulador/Inverso" class="painel">@Html.AntiForgeryToken()<h2>Quanto consigo conquistar?</h2><p class="muted">Descubra o resultado de contribuições constantes, sem juros ou rendimentos.</p><label for="valorMensal">Posso guardar por mês (R$)</label><input id="valorMensal" name="valorMensal" data-moeda inputmode="decimal" value="300,00" /><label for="meses">Durante quantos meses?</label><input id="meses" name="meses" type="number" min="1" max="1200" value="12" /><button class="btn btn-outline-primary mt-4">Simular conquista</button>@if(ViewBag.Resultado is decimal resultado){<strong class="resultado-grande">@resultado.ToString("C")</strong><p class="muted">Esse pode ser o começo da sua próxima conquista.</p>}<a class="btn btn-light mt-3" href="/Objetivos/Novo">Transformar em objetivo</a></form></div>
