@model PainelViewModel
@{ViewData["Title"]="Visão geral";var ativos=Model.Objetivos.Where(x=>x.Objetivo.Status=="Ativo").ToList();}
<div class="titulo-pagina"><div><span class="eyebrow">CADA PASSO CONTA</span><h1>Olá, @User.Identity?.Name <span class="aceno">✦</span></h1><p>Veja como está seu planejamento financeiro.</p></div><a class="btn btn-primary" href="/Objetivos/Novo"><i class="fa-solid fa-plus"></i> Novo objetivo</a></div>
<partial name="_Resumo" model="Model" />
<section class="planejamento-destaque"><div class="plano-principal"><span class="eyebrow"><i class="fa-solid fa-route"></i> SEU PLANEJAMENTO</span><h2>Seus sonhos têm um plano.</h2><p>Para manter seus objetivos, reserve aproximadamente</p><div class="plano-valor">@Model.Necessario.ToString("C") <span>/ mês</span></div><p class="alternativas">@ativos.Sum(x=>x.Calculo.Quinzenal).ToString("C") / quinzena <span>ou</span> @ativos.Sum(x=>x.Calculo.Semanal).ToString("C") / semana</p><a href="/Simulador">Explorar possibilidades <i class="fa-solid fa-arrow-right"></i></a></div><div class="plano-comparacao"><span class="icone-circulo"><i class="fa-solid fa-seedling"></i></span><h3>Espaço para conquistar</h3><div class="entre"><span>Sua capacidade estimada</span><strong>@Model.Capacidade.ToString("C")</strong></div><div class="entre"><span>Necessário para objetivos</span><strong>@Model.Necessario.ToString("C")</strong></div><div class="entre margem"><span>Margem disponível</span><strong>@Model.Margem.ToString("C")</strong></div><small>@(Model.Margem>=0?"Seu planejamento cabe na sua capacidade atual.":"Um ajuste no plano pode abrir novas possibilidades.")</small></div></section>
@if(Model.Margem<0){<div class="alert alert-warning">Seus objetivos exigem @Model.Necessario.ToString("C") por mês, e sua capacidade é @Model.Capacidade.ToString("C"). Você pode <a href="/Objetivos">aumentar o prazo ou reduzir o valor de um objetivo</a>, ou <a href="/Despesas">revisar suas despesas</a>.</div>}
<div class="secao-titulo"><div><h2>Seus objetivos <span class="contador">@ativos.Count</span></h2><p>Um pouco mais perto do que importa para você.</p></div><a href="/Objetivos">Ver todos <i class="fa-solid fa-arrow-right"></i></a></div>
@if(!ativos.Any()){<div class="estado-vazio"><span class="vazio-icone"><i class="fa-solid fa-bullseye"></i></span><h3>O que você quer conquistar?</h3><p>Uma viagem, a casa nova ou mais tranquilidade.<br />Seu primeiro objetivo começa com um plano.</p><a href="/Objetivos/Novo" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Criar primeiro objetivo</a></div>}
else {<div class="objetivos-grid">@foreach(var o in ativos.Take(3)){<partial name="_Objetivo" model="o" />}</div>}
<div class="duas-colunas"><section class="painel"><div class="secao-titulo"><h2>Próximos check-ins</h2><a href="/Calendario"><i class="fa-regular fa-calendar"></i></a></div>@foreach(var o in ativos.Where(x=>x.Calculo.ProximoCheckin.HasValue).OrderBy(x=>x.Calculo.ProximoCheckin).Take(4)){<a class="linha-lista" href="/Objetivos/Contribuicao/@o.Objetivo.Id"><span class="data-bloco"><strong>@o.Calculo.ProximoCheckin?.ToString("dd")</strong>@o.Calculo.ProximoCheckin?.ToString("MMM")</span><span class="flex-1"><strong>@o.Objetivo.Nome</strong><small>Hora de dar o próximo passo</small></span><strong>@o.Calculo.PorPeriodo.ToString("C")</strong></a>}@if(!ativos.Any()){<p class="vazio-pequeno">Os próximos passos dos seus objetivos aparecerão aqui.</p>}</section><section class="painel"><div class="secao-titulo"><h2>Últimas contribuições</h2><a href="/Contribuicoes">Ver todas</a></div>@foreach(var c in Model.Contribuicoes.Take(4)){<div class="linha-lista"><span class="icone-circulo"><i class="fa-solid fa-check"></i></span><span class="flex-1"><strong>@c.NomeObjetivo</strong><small>@c.Data.ToString("dd MMM yyyy")</small></span><strong class="receita">+ @c.Valor.ToString("C")</strong></div>}@if(!Model.Contribuicoes.Any()){<p class="vazio-pequeno">Cada contribuição é uma conquista.<br />Registre a primeira no seu objetivo.</p>}</section></div>
