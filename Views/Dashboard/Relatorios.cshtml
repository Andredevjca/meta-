@model PainelViewModel
@{ViewData["Title"]="Relatórios";var total=Model.Objetivos.Sum(x=>x.Objetivo.ValorAcumulado);}
<div class="titulo-pagina"><div><span class="eyebrow">VEJA O QUANTO VOCÊ JÁ CAMINHOU</span><h1>Suas conquistas em números</h1><p>Uma visão simples da evolução do seu planejamento.</p></div><button type="button" class="btn btn-light" onclick="window.print()"><i class="fa-solid fa-print"></i> Imprimir</button></div><partial name="_Resumo" model="Model" /><div class="duas-colunas"><section class="painel"><h2>Evolução do patrimônio dos objetivos</h2><p class="muted">Saldo acumulado ao final de cada mês, incluindo valores iniciais.</p>@for(var i=5;i>=0;i--){var mes=new DateTime(DateTime.Today.Year,DateTime.Today.Month,1).AddMonths(-i);var fim=mes.AddMonths(1);var saldo=Model.Objetivos.Where(x=>x.Objetivo.DataInicio<fim).Sum(x=>x.Objetivo.ValorInicial)+Model.Contribuicoes.Where(c=>c.Data<fim).Sum(c=>c.Valor);<div class="barra-relatorio"><span>@mes.ToString("MMM yyyy")</span><div class="progress"><div style="width:@((total>0?Math.Min(100,saldo/total*100):0).ToString("0.##",CultureInfo.InvariantCulture))%"></div></div><strong>@saldo.ToString("C")</strong></div>}</section><section class="painel"><h2>Despesas por categoria</h2>@foreach(var grupo in Model.Despesas.Where(x=>x.Ativo).GroupBy(x=>x.Categoria)){var valor=grupo.Sum(x=>PlanejamentoFinanceiroService.ValorMensal(x,DateTime.Today));<div class="barra-relatorio"><span>@grupo.Key</span><div class="progress"><div style="width:@((Model.DespesaMensal>0?valor/Model.DespesaMensal*100:0).ToString("0.##",CultureInfo.InvariantCulture))%"></div></div><strong>@valor.ToString("C")</strong></div>}@if(!Model.Despesas.Any()){<p class="vazio-pequeno">Cadastre despesas para visualizar a distribuição.</p>}</section></div><section class="painel"><h2>Objetivos e contribuições</h2><div class="table-responsive"><table class="table"><thead><tr><th>Objetivo</th><th>Status</th><th>Acumulado</th><th>Restante</th><th>Progresso</th><th>Por mês</th></tr></thead><tbody>@foreach(var p in Model.Objetivos){<tr><td><a href="/Objetivos/Detalhes/@p.Objetivo.Id">@p.Objetivo.Nome</a></td><td>@p.Objetivo.Status</td><td>@p.Objetivo.ValorAcumulado.ToString("C")</td><td>@p.Calculo.Restante.ToString("C")</td><td>@p.Calculo.Percentual.ToString("0")%</td><td>@p.Calculo.Mensal.ToString("C")</td></tr>}</tbody></table></div>@if(!Model.Objetivos.Any()){<p class="vazio-pequeno">Crie seu primeiro objetivo para acompanhar sua evolução.</p>}</section>
