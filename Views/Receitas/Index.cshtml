@model List<Lancamento>
@{
    string tipo = ViewBag.Tipo; ViewData["Title"] = tipo;
}
<div class="titulo-pagina">
    <div><span class="eyebrow">SUA REALIDADE, COM CLAREZA</span>
        <h1>@tipo</h1>
        <p>@(tipo == "Receitas" ? "Toda conquista começa com o que você tem hoje." : "Entenda para onde seu dinheiro vai e abra espaço para seus planos.")</p>
    </div><a class="btn btn-primary" href="/@tipo/Editar"><i class="fa-solid fa-plus"></i> @(tipo == "Receitas" ? "Nova receita" : "Nova despesa")</a>
</div>
<section class="painel">@if(Model.Count==0){
    <div class="estado-vazio"><i class="fa-solid fa-wallet vazio-icone"></i>
        <h3>@(tipo == "Receitas" ? "Cadastre sua primeira fonte de renda." : "Suas despesas aparecerão aqui.")</h3>
        <p>Com essas informações, seu planejamento fica mais preciso.</p><a class="btn btn-primary"
                                                                            href="/@tipo/Editar">Adicionar agora</a>
    </div>
}else
{

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Descrição</th>
                    <th>Categoria</th>
                    <th>Valor</th>
                    <th>Periodicidade</th>
                    <th>Data</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>@foreach(var l in Model){
                <tr>
                    <td><strong>@l.Descricao</strong></td>
                    <td>@l.Categoria</td>
                    <td>@l.Valor.ToString("C")</td>
                    <td>@l.Periodicidade</td>
                    <td>@l.Data.ToString("dd/MM/yyyy")</td>
                    <td><span class="badge-suave">@(l.Ativo ? "Ativa" : "Inativa")</span></td>
                    <td>
                        <div class="botoes">
                            <a href="/@tipo/Editar/@l.Id" class="icon-button" aria-label="Editar @l.Descricao"><i
                                class="fa-solid fa-pen"></i></a>
                                <form method="post" action="/@tipo/Excluir/@l.Id" data-confirm="Excluir este lançamento?">
                                    @Html.AntiForgeryToken()
                                    <button class="icon-button text-danger" aria-label="Excluir @l.Descricao"><i
                                        class="fa-regular fa-trash-can"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>