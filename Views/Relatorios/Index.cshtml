@model RelatoriosViewModel
@{ViewData["Title"]="Relatórios";}
<div class="titulo-pagina"><div><span class="eyebrow">VEJA O QUANTO VOCÊ JÁ CAMINHOU</span><h1>Suas conquistas em números</h1><p>Uma visão simples da evolução do seu planejamento.</p></div><button type="button" class="btn btn-light" onclick="window.print()"><i class="fa-solid fa-print"></i> Imprimir</button></div><partial name="_Resumo" model="Model.Painel" /><div class="duas-colunas"><section class="painel"><h2>Evolução do patrimônio dos objetivos</h2><p class="muted">Saldo acumulado ao final de cada mês, incluindo valores iniciais.</p>@foreach(var item in Model.Evolucao){<div class="barra-relatorio"><span>@item.Nome</span><div class="progress"><div style="width:@(item.Percentual.ToString("0.##",CultureInfo.InvariantCulture))%"></div></div><strong>@item.Valor.ToString("C")</strong></div>}</section><section class="painel"><h2>Despesas por categoria</h2>@foreach(var item in Model.Categorias){<div class="barra-relatorio"><span>@item.Nome</span><div class="progress"><div style="width:@(item.Percentual.ToString("0.##",CultureInfo.InvariantCulture))%"></div></div><strong>@item.Valor.ToString("C")</strong></div>}@if(!Model.Painel.Despesas.Any()){<p class="vazio-pequeno">Cadastre despesas para visualizar a distribuição.</p>}</section></div><section class="painel"><h2>Objetivos e contribuições</h2><div class="table-responsive"><table class="table"><thead><tr><th>Objetivo</th><th>Status</th><th>Acumulado</th><th>Restante</th><th>Progresso</th><th>Por mês</th></tr></thead><tbody>@foreach(var p in Model.Painel.Objetivos){<tr><td><a href="/Objetivos/Detalhes/@p.Objetivo.Id">@p.Objetivo.Nome</a></td><td>@p.Objetivo.Status</td><td>@p.Objetivo.ValorAcumulado.ToString("C")</td><td>@p.Calculo.Restante.ToString("C")</td><td>@p.Calculo.Percentual.ToString("0")%</td><td>@p.Calculo.Mensal.ToString("C")</td></tr>}</tbody></table></div>@if(!Model.Painel.Objetivos.Any()){<p class="vazio-pequeno">Crie seu primeiro objetivo para acompanhar sua evolução.</p>}</section>
