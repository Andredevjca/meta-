@model Objetivo
@{ViewData["Title"]=Model.Id==0?"Novo objetivo":"Editar objetivo";}
<a class="voltar" href="/Objetivos"><i class="fa-solid fa-arrow-left"></i> Meus objetivos</a><div class="titulo-pagina"><div><h1>@ViewData["Title"]</h1><p>Deixe o sonho com você. A gente ajuda com o plano.</p></div></div>
<form method="post" asp-action="Salvar" class="form-objetivo" id="form-objetivo"><input asp-for="Id" type="hidden" /><div class="painel form-principal"><div asp-validation-summary="All" class="validation"></div><h2><span class="etapa">01</span> O que você quer conquistar?</h2><label asp-for="Nome">Nome do objetivo</label><input asp-for="Nome" placeholder="Ex.: Minha viagem para Natal" /><label asp-for="Descricao">Descrição <span class="muted">(opcional)</span></label><textarea asp-for="Descricao" rows="2"></textarea><div class="campo-grid"><div><label asp-for="Categoria">Categoria</label><select asp-for="Categoria">@foreach(var c in new[]{"Viagem","Casa","Carro","Educação","Reserva","Compras","Notebook","IPVA","Outro"}){<option>@c</option>}</select></div><div><label asp-for="Icone">Ícone</label><select asp-for="Icone"><option value="fa-plane">✈ Viagem</option><option value="fa-house">⌂ Casa</option><option value="fa-car">Carro</option><option value="fa-graduation-cap">Educação</option><option value="fa-piggy-bank">Reserva</option><option value="fa-bag-shopping">Compras</option><option value="fa-laptop">Notebook</option><option value="fa-bullseye">Objetivo</option></select></div></div><label asp-for="ValorObjetivo">Quanto você precisa? (R$)</label><input asp-for="ValorObjetivo" type="text" inputmode="decimal" data-moeda placeholder="5.000,00" />
<h2><span class="etapa">02</span> Quanto você já possui?</h2><label asp-for="ValorInicial">Valor inicial guardado (R$)</label><input asp-for="ValorInicial" type="text" inputmode="decimal" data-moeda /><small class="muted">As contribuições registradas serão somadas a esse valor.</small>
<h2><span class="etapa">03</span> Quando quer chegar lá?</h2><div class="campo-grid"><div><label asp-for="DataInicio">Data inicial</label><input asp-for="DataInicio" type="date" /></div><div><label asp-for="DataLimite">Data limite</label><input asp-for="DataLimite" type="date" /></div></div>
<h2><span class="etapa">04</span> Como deseja contribuir?</h2><div class="campo-grid"><div><label asp-for="Frequencia">Frequência</label><select asp-for="Frequencia"><option value="Semanal">Toda semana</option><option value="Quinzenal">A cada 15 dias</option><option value="Mensal">Todo mês</option></select></div><div><label asp-for="Prioridade">Prioridade</label><select asp-for="Prioridade"><option value="1">Alta</option><option value="2">Média</option><option value="3">Baixa</option></select></div></div>@if(Model.Id>0){<label asp-for="Status">Status</label><select asp-for="Status"><option>Ativo</option><option>Pausado</option><option>Cancelado</option><option>Concluído</option></select><small>O objetivo só é concluído quando o saldo atinge o valor desejado.</small>}<div class="form-acoes"><a href="/Objetivos" class="btn btn-light">Cancelar</a><button class="btn btn-primary">@(Model.Id==0?"Criar objetivo":"Salvar alterações") <i class="fa-solid fa-arrow-right"></i></button></div></div><aside class="painel simulacao"><span class="eyebrow">UM PLANO PARA SUA CONQUISTA</span><span class="simulacao-icone"><i class="fa-solid fa-bullseye"></i></span><h2>Vamos dar forma ao seu plano?</h2><p class="muted">Preencha os valores e o prazo para descobrir quanto reservar.</p><button type="button" class="btn btn-outline-primary w-100" id="simular">Calcular meu plano</button><div id="resultado-simulacao" aria-live="polite"></div><small class="muted">Sem rendimentos ou juros. Valores calculados a partir do calendário, arredondados para cima em centavos.</small></aside></form>
