@model Contribuicao
@{var p=(ObjetivoPlanejado)ViewBag.Objetivo;ViewData["Title"]="Check-in da meta";}
<a href="/Objetivos/Detalhes/@Model.ObjetivoId" class="voltar">← Voltar ao objetivo</a><div class="titulo-pagina"><div><span class="eyebrow">CADA CONTRIBUIÇÃO IMPORTA</span><h1>Hora de atualizar seu objetivo 🎯</h1><p>@p.Objetivo.Nome</p></div></div><div class="painel form-limitado"><span class="badge-suave">Planejado para o período: @p.Calculo.PorPeriodo.ToString("C")</span><form method="post" asp-action="Contribuicao"><div asp-validation-summary="All" class="validation"></div><input asp-for="ObjetivoId" type="hidden" /><label asp-for="Valor">Quanto você conseguiu guardar? (R$)</label><input asp-for="Valor" type="text" inputmode="decimal" data-moeda autofocus /><label asp-for="Data">Data da contribuição</label><input asp-for="Data" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" min="@p.Objetivo.DataInicio.ToString("yyyy-MM-dd")" /><label asp-for="Observacao">Observação (opcional)</label><textarea asp-for="Observacao" rows="3" placeholder="Uma conquista de cada vez..."></textarea><p class="muted mt-3">Depois de registrar, seu planejamento será recalculado com o valor realmente guardado.</p><button class="btn btn-primary w-100">Registrar contribuição <i class="fa-solid fa-check"></i></button></form></div>
