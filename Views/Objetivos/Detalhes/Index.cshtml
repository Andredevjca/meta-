@model DetalheObjetivoViewModel
@{var o=Model.Planejado.Objetivo;var c=Model.Planejado.Calculo;ViewData["Title"]=o.Nome;}
<a href="/Objetivos" class="voltar"><i class="fa-solid fa-arrow-left"></i> Meus objetivos</a><div class="titulo-pagina"><div><span class="eyebrow">@o.Categoria.ToUpper() · @o.Status.ToUpper()</span><h1><i class="fa-solid @o.Icone"></i> @o.Nome</h1><p>@o.Descricao</p></div><div class="botoes">@if(o.Status=="Ativo"){<a class="btn btn-primary" href="/Objetivos/Contribuicao/@o.Id"><i class="fa-solid fa-plus"></i> Registrar contribuição</a>}<a class="btn btn-light" href="/Objetivos/Editar/@o.Id">Editar objetivo</a></div></div>
@if(o.Status=="Concluído"){<section class="conquista"><span>✦</span><h2>Objetivo alcançado!</h2><p>Você conseguiu conquistar sua meta. @o.ValorAcumulado.ToString("C") guardados em @Model.Contribuicoes.Count contribuições.</p><p>@o.DataConclusao?.ToString("dd/MM/yyyy") · @Math.Max(0,((o.DataConclusao??DateTime.Today)-o.DataInicio).Days) dias de caminhada</p><a class="btn btn-primary" href="/Objetivos/Novo">Criar novo objetivo</a></section>}
@if(c.Atrasado){<div class="alert alert-warning">O prazo chegou e ainda faltam @c.Restante.ToString("C"). Ajuste a data limite para distribuir as próximas contribuições.</div>}
<section class="painel"><div class="secao-titulo"><h2>Sua conquista está @c.Percentual.ToString("0")% completa</h2><span>Até @o.DataLimite.ToString("dd/MM/yyyy")</span></div><div class="progress grande"><div style="width:@c.Percentual.ToString("0.##",CultureInfo.InvariantCulture)%"></div></div><div class="metricas"><div><small>Já conquistado</small><strong>@o.ValorAcumulado.ToString("C")</strong></div><div><small>Seu objetivo</small><strong>@o.ValorObjetivo.ToString("C")</strong></div><div><small>Falta guardar</small><strong>@c.Restante.ToString("C")</strong></div><div><small>@c.Periodos períodos restantes</small><strong>@c.PorPeriodo.ToString("C")</strong><small>@o.Frequencia · @Math.Max(0,(o.DataLimite-DateTime.Today).Days) dias</small></div></div><p class="muted">Previsão seguindo o plano: @(c.Previsao?.ToString("dd/MM/yyyy")??"redefina o prazo") · Próximo check-in: @(c.ProximoCheckin?.ToString("dd/MM/yyyy")??"—")</p></section>
<div class="duas-colunas"><section class="painel"><h2>Linha do tempo</h2>@foreach(var h in Model.Historico){<div class="timeline-item"><small>@h.DataInclusao.ToString("dd/MM/yyyy HH:mm")</small><p>@h.Descricao</p></div>}</section><section class="painel"><h2>Suas contribuições</h2>@foreach(var d in Model.Contribuicoes){<div class="linha-lista"><span class="flex-1"><strong>@d.Data.ToString("dd/MM/yyyy")</strong><small>@d.Observacao</small></span><strong class="receita">+ @d.Valor.ToString("C")</strong></div>}@if(!Model.Contribuicoes.Any()){<p class="vazio-pequeno">Seu primeiro passo vai aparecer aqui.</p>}</section></div><form method="post" asp-action="Excluir" asp-route-id="@o.Id" data-confirm="Excluir este objetivo e todas as suas contribuições? Esta ação não pode ser desfeita."><button class="btn btn-link text-danger">Excluir objetivo</button></form>
