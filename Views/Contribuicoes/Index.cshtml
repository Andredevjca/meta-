@model List<Contribuicao>
@{ViewData["Title"]="Contribuições";}
<div class="titulo-pagina"><div><span class="eyebrow">SEU ESFORÇO GANHA FORMA</span><h1>Minhas contribuições</h1><p>Cada valor guardado conta uma parte da sua história.</p></div><a class="btn btn-primary" href="/Objetivos">Contribuir para um objetivo</a></div><section class="painel">@if(!Model.Any()){<div class="estado-vazio"><i class="fa-solid fa-coins vazio-icone"></i><h3>Sua jornada começa com o primeiro passo.</h3><p>Abra um objetivo para registrar sua primeira contribuição.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Data</th><th>Objetivo</th><th>Valor guardado</th><th>Observação</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Data.ToString("dd/MM/yyyy")</td><td><a href="/Objetivos/Detalhes/@c.ObjetivoId">@c.NomeObjetivo</a></td><td class="receita">+ @c.Valor.ToString("C")</td><td>@c.Observacao</td></tr>}</tbody></table></div>}</section>
